{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grimorio.proper_names/v1",
  "title": "Grimorio proper name catalog",
  "type": "object",
  "required": ["schema", "language", "names"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "grimorio.proper_names/v1"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "patron", "verbal"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "patron": { "type": "string", "minLength": 1 },
          "verbal": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
